# Copy this file to .env and fill in your key, or run `ant auth login` instead
# (the SDK picks up a stored login profile automatically and this file can
# stay untouched).
ANTHROPIC_API_KEY=sk-ant-...

# Optional, phase 2 backend: switch storage from the default local SQLite
# file to Postgres (install the "postgres" extra for the driver).
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/relook

# Optional, phase 3 backend: which frontend origin(s) may call the API.
# RELOOK_CORS_ORIGINS=http://localhost:5173

# Optional, phase 3 backend: email notifications for task owners. Leave
# unset to keep notifications in-app only.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASSWORD=...
# SMTP_FROM=relook@example.com
# SMTP_USE_TLS=true

# Optional, phase 3 backend: Slack notifications via an incoming webhook.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
